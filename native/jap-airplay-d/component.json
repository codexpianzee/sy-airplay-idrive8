{
  "id": "jap-airplay-d",
  "kind": "tool",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "title": "AirPlay service (iDrive 8)",
  "description": "AirPlay screen mirroring from an iPhone to the iDrive 8 display: runs h4m4d's AirPlay receiver (airplay-rx, UxPlay's AirPlay library) only while the AirPlay app is open, and opens the car Wi-Fi's firewall for it meanwhile. Video only: the sound stays on Bluetooth to the car.",
  "author": "trnaslan",
  "requires": {
    "mgu-deploy": "0.7.0"
  },
  "uninstallable": true,
  "mguHmi": ["ID8"],
  "files": [
    { "path": "airplayd.js", "from": "airplayd.js", "mode": "0644" },
    { "path": "airplay-rx", "from": "build/airplay-rx", "mode": "0755" },
    { "path": "check.sh", "from": "check.sh", "mode": "0755" },
    { "path": "LICENSE", "from": "../../LICENSE", "mode": "0644" },
    { "path": "NOTICE.md", "from": "../../NOTICE.md", "mode": "0644" }
  ],
  "check": ["check.sh"],
  "units": [
    { "name": "jap-airplay-d.service", "from": "systemd/jap-airplay-d.service" }
  ],
  "enable": [
    { "unit": "jap-airplay-d.service", "target": "multi-user.target" }
  ],
  "crashNames": ["airplay-rx"],
  "restart": ["jap-airplay-d.service"]
}
